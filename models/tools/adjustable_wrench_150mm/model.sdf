          <ixz>2.289810e-11</ixz>
          <iyy>2.854696e-04</iyy>
          <iyz>1.461301e-09</iyz>
          <izz>1.091046e-05</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://adjustable_wrench_150mm/meshes/adjustable_wrench_150mm.dae</uri>
          </mesh>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://adjustable_wrench_150mm/meshes/adjustable_wrench_150mm.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

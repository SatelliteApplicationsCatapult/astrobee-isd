          <iyz>-2.215437e-07</iyz>
          <izz>5.066222e-05</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://adjustable_wrench_200mm/meshes/adjustable_wrench_200mm.dae</uri>
          </mesh>
        </geometry>
      </collision>
      <visual name="visual">

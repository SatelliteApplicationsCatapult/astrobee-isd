          <iyz>-1.778740e-09</iyz>
          <izz>1.026147e-06</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://flathead_screwdriver/meshes/flathead_screwdriver.dae</uri>
          </mesh>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://flathead_screwdriver/meshes/flathead_screwdriver.dae</uri>
          </mesh>
        </geometry>

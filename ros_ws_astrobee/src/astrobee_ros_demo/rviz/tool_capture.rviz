Panels:
  - Class: rviz/Displays
    Help Height: 138
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /TF1/Frames1
        - /RobotModel1
      Splitter Ratio: 0.5234460234642029
    Tree Height: 1790
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
